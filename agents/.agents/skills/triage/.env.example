# Triage skill — environment file
#
# Copy this file to `.env` in the same directory and fill in the values:
#   cp .env.example .env
#
# The orchestrator (scripts/triage.mjs) loads this file automatically when it
# starts. Values already present in the shell env take precedence over this
# file (so you can still override individual keys inline for one-off runs).
#
# Do NOT commit the real .env. The sibling .gitignore ignores it.


# --- Required -----------------------------------------------------------------

# Cursor API key used by @cursor/sdk to spawn agents.
# Starts with "cursor_...". Mint one at:
#   https://cursor.com/dashboard  →  Integrations  →  API Keys
CURSOR_API_KEY=


# --- Optional: MCP overrides --------------------------------------------------
#
# The agents spawned by the orchestrator each get their own MCP processes.
# The defaults in triage.mjs assume `uvx mcp-atlassian` and
# `npx -y @dbhub/mcp`. If your real MCPs look different (check
# ~/.cursor/mcp.json), set these to the exact command + args.
#
# Whitespace-separated; first token is the command, rest are args.

# Atlassian MCP command. Default if unset: "uvx mcp-atlassian".
# Example if you use the hosted SSE variant:
#   ATLASSIAN_MCP_CMD=npx mcp-remote https://mcp.atlassian.com/v1/sse
ATLASSIAN_MCP_CMD=

# dbhub MCP command. Default if unset: "npx -y @dbhub/mcp".
# Strongly recommended to point this at a Neon DEV BRANCH DSN, not prod.
# Example:
#   DBHUB_MCP_CMD=npx @bytebase/dbhub@0.18.0 --transport stdio --dsn postgresql://USER:PASS@HOST/DB?sslmode=require
DBHUB_MCP_CMD=
